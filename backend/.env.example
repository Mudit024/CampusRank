# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/campusrank

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP/Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=CampusRank <no-reply@campusrank.ac.in>

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend Client Origin
FRONTEND_URL=http://localhost:5173
